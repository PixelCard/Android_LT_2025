+                    txtErrorName.setError(null);
+                }
+                if (author.isEmpty()) {
+                    txtErrorAuthor.setError("Không được để trống tác giả");
+                    isvalid = false;
+                } else {
+                    txtErrorAuthor.setError(null);
+                }
+                if (description.isEmpty()) {
