<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Admin.Create">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintRight_toRightOf="parent"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create"
            android:textSize="30sp"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:gravity="center"
            >

        </TextView>

        <Button
            android:id="@+id/btnProductPageAdmin"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"
            android:text="Trang product gốc"
            android:textSize="15sp"
            >
        </Button>

        <Button
            android:id="@+id/btnCategoryPageAdmin"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"
            android:text="Trang Category"
            android:textSize="15sp"
            >
        </Button>

        <Button
            android:id="@+id/btnChapterPageAdmin"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"
            android:text="Trang chapter"
            android:textSize="15sp"
            >
        </Button>

        <Button
            android:id="@+id/btnAccountPageAdmin"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"
            android:text="Trang Account"
            android:textSize="15sp"
            >
        </Button>

        <Button
            android:id="@+id/btn_CommentPageAdmin"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"
            android:text="Trang Comment"
            android:textSize="15sp"
            >
        </Button>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>