<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp">

    <LinearLayout
        android:id="@+id/itemContainerProduct_Admin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/tvTenTruyen" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Tên truyện" android:textStyle="bold"
                android:textSize="16sp" android:textColor="#000000" />

            <TextView android:id="@+id/tvId" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="ID: ..." android:textSize="14sp" />

            <TextView android:id="@+id/tvAuthor" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Tác giả" android:textSize="14sp" />

            <TextView android:id="@+id/tvDescription" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Mô tả" android:textSize="14sp"
                android:maxLines="2" android:ellipsize="end" />

            <TextView android:id="@+id/tvCreateDate" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Ngày tạo" android:textSize="14sp"
                android:textColor="#666666" />


        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>